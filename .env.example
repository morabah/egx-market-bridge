# Optional. Leave blank for DelayedFeed mode if the API permits it.
# If you have licensed/authenticated EGID access, set provider_mode to "feed"
# in config.json and place the bearer token here.
EGID_TOKEN=

# Optional TradingView credentials (anonymous mode works with limits)
TRADINGVIEW_USERNAME=
TRADINGVIEW_PASSWORD=

# Optional self-hosted borsa base URL (e.g. http://localhost:8000)
BORSA_BASE_URL=
